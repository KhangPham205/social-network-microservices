# Copy to docker/.env and adjust. These values match the local defaults compiled into each
# service's application.yaml, so `docker compose up -d` plus running the services from the IDE
# works out of the box.
#
#   cp env.example .env

# ---------------------------------------------------------------- PostgreSQL (one DB per service)
POSTGRES_USER=root
POSTGRES_PASSWORD=password

# ---------------------------------------------------------------- MongoDB (chat messages)
MONGO_USER=admin
MONGO_PASSWORD=password

# ---------------------------------------------------------------- MinIO (object storage)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_BUCKET=social-media

# ---------------------------------------------------------------- Neo4j (social graph)
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ---------------------------------------------------------------- Admin UIs
PGADMIN_EMAIL=admin@social.com
PGADMIN_PASSWORD=admin

# ---------------------------------------------------------------- Application secrets
# Development values only. Generate real ones for any deployment:  openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
INTERNAL_API_TOKEN=dev-only-internal-token-change-me

# ---------------------------------------------------------------- Frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------- SMTP (auth-service e-mail OTP)
# Leave empty to disable outgoing mail in development.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
